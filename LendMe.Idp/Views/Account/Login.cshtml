<!-- Views/Account/Login.cshtml -->
@model LendMe.Idp.Models.LoginViewModel
@using LendMe.Idp.Infrastructure.Persistance.Entity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Log in";
    Layout = null; // Special layout for auth pages
    var schemes = await SignInManager.GetExternalAuthenticationSchemesAsync();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Identity Provider</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
        }
        .login-container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            padding: 2rem;
        }
        .social-btn {
            position: relative;
            padding-left: 40px;
            text-align: left;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .social-btn i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
        }
        .divider {
            text-align: center;
            margin: 1.5rem 0;
            position: relative;
        }
        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #dee2e6;
        }
        .divider span {
            background: white;
            padding: 0 1rem;
            position: relative;
            color: #6c757d;
            font-size: 0.875rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="login-container">
                    <h2 class="text-center mb-4">Sign In</h2>
                    
                    @if (schemes.Any())
                    {
                        <form asp-action="ExternalLogin" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                            <div class="d-grid gap-2">
                                @foreach (var provider in schemes)
                                {
                                    <button type="submit" name="provider" value="@provider.Name" 
                                            class="btn btn-outline-secondary social-btn @($"social-btn-{provider.Name.ToLower()}")">
                                        @if (provider.Name == "Google")
                                        {
                                            <i class="bi bi-google"></i>
                                            <span>Continue with Google</span>
                                        }
                                        else if (provider.Name == "Facebook")
                                        {
                                            <i class="bi bi-facebook"></i>
                                            <span>Continue with Facebook</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-box-arrow-in-right"></i>
                                            <span>Continue with @provider.DisplayName</span>
                                        }
                                    </button>
                                }
                            </div>
                        </form>
                        
                        <div class="divider">
                            <span>OR</span>
                        </div>
                    }
                    
                    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger" asp-validation-summary-exclude="None"></div>
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Enter your email" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">
                                @Html.DisplayNameFor(m => m.RememberMe)
                            </label>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Sign In</button>
                        </div>
                    </form>
                    <hr />
                    <div class="text-center">
                        <p class="mb-0">Don't have an account?</p>
                        <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-decoration-none">
                            Create a new account
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>